# ==============================================================
#  SISTEMA DE ENVIO DE BOLETOS - PHP PURO
#  Copie este arquivo para .env e preencha com as credenciais reais
#  NUNCA envie o .env para o repositório
# ==============================================================

# ---------------- Banco de Dados MySQL (fornecedores + logs) ----------------
DB_HOST=host_do_mysql
DB_PORT=3306
DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASS=senha_do_banco
DB_CHARSET=utf8mb4

# ---------------- Conexão MSSQL (repositório corporativo GATE - somente leitura) ----------------
# Driver: 'sqlsrv' (pdo_sqlsrv) ou 'ODBC Driver 17 for SQL Server' (pdo_odbc)
MSSQL_DRIVER=sqlsrv
MSSQL_HOST=host_do_mssql
MSSQL_PORT=1433
MSSQL_DB=nome_banco_mssql
MSSQL_USER=usuario_mssql
MSSQL_PASS=senha_mssql
MSSQL_TABELA=wgfor

# ---------------- SMTP corporativo (envio de e-mails) ----------------
# Porta 465 -> SMTP_SECURE=ssl | Porta 587 -> SMTP_SECURE=tls
SMTP_HOST=smtp.corporativo.com.br
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=usuario_smtp
SMTP_PASS=senha_smtp
SMTP_FROM=email_remetente@empresa.com.br
SMTP_FROM_NAME=Sua Empresa
CC_FIXO=email_copia@empresa.com.br
ENVIO_EMAIL_COPIA=1

# ---------------- JWT (autenticação) ----------------
# IMPORTANTE: gere uma chave aleatória longa (ex.: openssl rand -hex 64)
JWT_SECRET=COLOQUE-UMA-CHAVE-ALEATORIA-LONGA
JWT_EXPIRY=7200

# ---------------- Login / Segurança ----------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=30
RATE_LIMIT_PER_MINUTE=120

# ---------------- Upload ----------------
UPLOAD_MAX_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,xlsx,xls,docx,doc,csv

# ---------------- Worker / Fila ----------------
WORKER_LIMITE=20
WORKER_INTERVALO_SEGUNDOS=2
WORKER_MAX_TENTATIVAS=3